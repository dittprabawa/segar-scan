# Salin file ini menjadi .env dan sesuaikan nilainya

# ============================================================================
# Gemini VLM (wajib untuk penilaian visual kesegaran dan jenis)
# ============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
# Model dicoba berurutan jika model pertama mengalami overload; pisahkan koma
GEMINI_MODEL=gemini-2.5-flash,gemini-2.0-flash
# Set ke 0 untuk menonaktifkan Gemini dan hanya pakai model lokal
USE_VLM=1
# Batas waktu (detik) per panggilan Gemini
VLM_TIMEOUT=15

# ============================================================================
# Penyimpanan Dataset Pending (Integrasi Online & Lokal)
# ============================================================================
# DATASET_CAPTURE: 1 untuk mengumpulkan hasil scan sebagai dataset pending, 0 untuk menonaktifkan
DATASET_CAPTURE=1

# Pilihan STORAGE_BACKEND: auto | supabase | s3 | r2 | vercel_blob | local
# Jika 'auto' (atau tidak diisi), backend otomatis dipilih berdasarkan variabel di bawah.
STORAGE_BACKEND=auto

# --- OPSI 1: SUPABASE (Sangat direkomendasikan untuk Vercel) ---
# Supabase menyediakan Object Storage untuk foto (.img) dan database PostgreSQL
# untuk metadata pending. Keduanya gratis dan terhubung langsung dari cloud.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your_supabase_anon_or_service_role_key
# SUPABASE_STORAGE_BUCKET=pending
# SUPABASE_TABLE=pending_scans

# --- OPSI 2: CLOUDFLARE R2 / AWS S3 (S3-Compatible Object Storage) ---
# Cloudflare R2 memiliki gratis 10 GB & bebas biaya transfer data (zero egress).
# S3_BUCKET=segarscan-pending
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com  # Kosongkan jika AWS S3 biasa
# S3_REGION=auto
# S3_PREFIX=pending/

# --- OPSI 3: VERCEL BLOB (Penyimpanan bawaan Vercel) ---
# Otomatis diisi oleh Vercel saat Anda menghubungkan Vercel Blob di dashboard Vercel.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# BLOB_PREFIX=pending/

# --- OPSI 4: PENYIMPANAN LOKAL (Laptop / Server fisik) ---
# Dipakai otomatis jika tidak ada kredensial cloud di atas.
# DATASET_PENDING_DIR=data/pending
# DATASET_PENDING_MAX_MB=512
# DATASET_RETENTION_DAYS=30
# DATASET_VERIFIED_MAX_MB=2048

# ============================================================================
# Model lokal & Evaluasi
# ============================================================================
# Path model classifier lokal (misal PyTorch atau k-NN)
MODEL_PATH=models/segarscan.pt

# ============================================================================
# Konfigurasi Server & Keamanan
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT=10/minute
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXIES=127.0.0.1

