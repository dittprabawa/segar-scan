# Salin file ini menjadi .env dan sesuaikan nilainya

# --- Gemini VLM (wajib untuk demo tanpa model lokal) ---
GEMINI_API_KEY=isi_api_key_anda_di_sini
# Model dicoba berurutan; pisahkan dengan koma
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash
# Set ke 0 untuk menonaktifkan Gemini dan hanya pakai model lokal
USE_VLM=1
# Batas waktu (detik) per model Gemini
VLM_TIMEOUT=20

# --- Model lokal PyTorch (opsional) ---
MODEL_PATH=models/segarscan.pt

# --- Konfigurasi server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Ambang batas kualitas foto (opsional, nilai default sudah cukup) ---
# QC_GELAP=35       # rata-rata kecerahan minimum (0-255)
# QC_SILAU=240      # rata-rata kecerahan maksimum (0-255)
# QC_BURAM=15       # variansi Laplacian minimum (semakin kecil = lebih buram)
